{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
{% assign setting = section.settings %}

{%- style -%}
	#shopify-section-{{ section.id }} {
		--padding-xl: {{ setting.pad_desk | append: 'px' }};
		--padding-lg: {{ setting.pad_lap | append: 'px' }};
		--padding-md: {{ setting.pad_tab | append: 'px' }};
		--padding-sm: {{ setting.pad_mob | append: 'px' }};
		--inputs-radius: 0;
	}
	accordion-item[open] {
    padding-bottom: 3rem;
	}
{%- endstyle -%}

<div class="main-contact color-{{ setting.section_colors }} custom-section">
	<div class="page-width md:!ts-px-12">
		<div class="contact-wrapper ts-grid lg:ts-grid-cols-2 ts-grid-cols-1 xl:ts-gap-40 lg:ts-gap-24 ts-gap-20">
			<div class="contact-form-colmn{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
				{%- if setting.form_title != blank -%}
					<h2 class="form-title ts-text-size_md ts-uppercase ts-font-bold ts-mb-7">
						{{ setting.form_title }}
					</h2>
				{%- endif -%}
				<div class="form wrapper">
					{%- form 'contact', id: 'ContactForm', class: 'isolate ts-space-y-5' -%}
						{%- if form.posted_successfully? -%}
							<h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
								{{- 'icon-success.svg' | inline_asset_content -}}
								{{ 'templates.contact.form.post_success' | t }}
							</h2>
						{%- elsif form.errors -%}
							<div class="form__message">
								<h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
									{{- 'icon-error.svg' | inline_asset_content -}}
									{{ 'templates.contact.form.error_heading' | t }}
								</h2>
							</div>
							<ul class="form-status-list caption-large" role="list">
								<li>
									<a href="#ContactForm-email" class="link">
										{{ form.errors.translated_fields.email | capitalize }}
										{{ form.errors.messages.email }}
									</a>
								</li>
							</ul>
						{%- endif -%}

						<div class="field-wrapper">
							<label class="field-label ts-text-size_sm ts-text-[#666666] ts-mb-3" for="ContactForm-name">
								{{ 'templates.contact.form.name' | t }}
							</label>
							<input
								class="field__input"
								autocomplete="name"
								type="text"
								id="ContactForm-name"
								name="contact[{{ 'templates.contact.form.name' | t }}]"
								value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
								placeholder="{{ 'templates.contact.form.name' | t }}">
						</div>
						<div class="field-wrapper field--with-error">
							<label class="field-label ts-text-size_sm ts-text-[#666666] ts-mb-3" for="ContactForm-email">
								{{- 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span>
							</label>
							<input
								autocomplete="email"
								type="email"
								id="ContactForm-email"
								class="field__input"
								name="contact[email]"
								spellcheck="false"
								autocapitalize="off"
								value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
								aria-required="true"
								{% if form.errors contains 'email' %}
									aria-invalid="true"
									aria-describedby="ContactForm-email-error"
								{% endif %}
								placeholder="{{ 'templates.contact.form.email' | t }}"
							>
							{%- if form.errors contains 'email' -%}
								<small class="contact__field-error" id="ContactForm-email-error">
									<span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
									<span class="form__message">
										<span class="svg-wrapper">
											{{- 'icon-error.svg' | inline_asset_content -}}
										</span>
										{{- form.errors.translated_fields.email | capitalize }}
										{{ form.errors.messages.email -}}
									</span>
								</small>
							{%- endif -%}
						</div>
						<div class="field-wrapper">
							<label class="field-label ts-text-size_sm ts-text-[#666666] ts-mb-3" for="ContactForm-body">
								{{- 'templates.contact.form.comment' | t -}}
							</label>
							<textarea
								rows="10"
								id="ContactForm-body"
								class="text-area field__input !ts-h-40"
								name="contact[{{ 'templates.contact.form.comment' | t }}]"
								placeholder="{{ 'templates.contact.form.comment' | t }}"
							>
								{{- form.body -}}
							</textarea>
						</div>
						<div class="contact__button">
							<button type="submit" class="button--full-width btn">
								{{ 'templates.contact.form.send' | t }}
							</button>
						</div>
					{%- endform -%}
				</div>
			</div>
			<div class="contact-text-colmn{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
				{%- if setting.title != blank -%}
					<h3 class="contact-title ts-text-size_lg ts-uppercase ts-mb-8">
						{{ setting.title }}
					</h3>
				{%- endif -%}

				{%- if setting.contact_body != blank -%}
					<div class="rte ts-text-size_sm ts-leading-[1.8] ts-space-y-8">
						{{ setting.contact_body }}
					</div>
				{%- endif -%}
			</div>

			{%- if setting.faq_enable and section.blocks.size > 0 -%}
				<div class="faq-colmn lg:ts-col-start-2">
					{%- if setting.faq_title != blank -%}
						<h3 class="faq-title ts-text-size_lg ts-uppercase ts-mb-8">
							{{ setting.faq_title }}
						</h3>
					{%- endif -%}

					<accordion-element data-toggle-first>
						{%- for block in section.blocks -%}
							{%- assign faq_item = block.settings -%}
							{%- if faq_item.question != blank and faq_item.answer != blank -%}
								<accordion-item class="ts-block ts-transition-all ts-duration-300{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %} ts-border-0 ts-border-b ts-border-solid ts-border-[#666666] ts-pb-4"
								{% if settings.animations_reveal_on_scroll %} data-cascade style="--animation-order: {{ forloop.index  }};"{% endif %} {{ block.shopify_attributes }}>
									<div class="accordion-header ts-font-bold ts-text-accent ts-text-size_sm ts-cursor-pointer ts-uppercase ts-select-none{%  unless forloop.first %} ts-pt-[1.3rem]{% endunless %}" slot="header">
										{{ faq_item.question }}
									</div>
									<div class="accordion-content ts-mt-2 ts-max-h-0 ts-overflow-hidden ts-text-size_sm">
										{{ faq_item.answer }}
									</div>
								</accordion-item>
							{%- endif -%}
						{%- endfor -%}
					</accordion-element>
				</div>
			{%- endif -%}
		</div>
	</div>
</div>

{% schema %}
	{
		"name": "Main Contact",
		"class": "cow-main-contact",
		"tag": "section",
		"settings": [
			{
				"type": "color_scheme",
				"id": "section_colors",
				"label": "Section Color Scheme",
				"default": "scheme-1"
			},
			{
				"type": "inline_richtext",
				"id": "title",
				"label": "Title",
				"default": "Contact Us"
			},
			{
				"type": "richtext",
				"id": "contact_body",
				"label": "Content",
				"default": "<p>Content goes here</p>"
			},
			{
        "type": "header",
        "content": "Contact Form"
      },
			{
				"type": "inline_richtext",
				"id": "form_title",
				"label": "Form Title",
				"default": "Message Us"
			},
			{
        "type": "header",
        "content": "FAQs"
      },
			{
				"type": "checkbox",
				"id": "faq_enable",
				"label": "Show FAQs",
				"default": true,
				"info": "Use section blocks to add FAQ items"
			},
			{
				"type": "inline_richtext",
				"id": "faq_title",
				"label": "FAQ Title",
				"default": "FAQs"
			},
			{
        "type": "header",
        "content": "Section spacing",
        "info": "Top and bottom padding"
      },
      {
        "type": "range",
        "id": "pad_desk",
        "label": "Dektop",
        "unit": "px",
        "min": 10,
        "max": 250,
        "step": 10,
        "default": 100,
				"info": "Padding"
      },
      {
        "type": "range",
        "id": "pad_lap",
        "label": "Laptop",
        "unit": "px",
        "min": 10,
        "max": 250,
        "step": 10,
        "default": 80,
				"info": "Padding"
      },
      {
        "type": "range",
        "id": "pad_tab",
        "label": "Tablet",
        "unit": "px",
        "min": 10,
        "max": 250,
        "step": 10,
        "default": 60,
				"info": "Padding"
      },
      {
        "type": "range",
        "id": "pad_mob",
        "label": "Mobile",
        "unit": "px",
        "min": 10,
        "max": 250,
        "step": 10,
        "default": 40,
				"info": "Padding"
      }
		],
		"blocks": [
			{
				"type": "faq",
				"name": "FAQ Item",
				"settings": [
					{
						"type": "inline_richtext",
						"id": "question",
						"label": "Question",
						"default": "Question goes here"
					},
					{
						"type": "richtext",
						"id": "answer",
						"label": "Answer",
						"default": "<p>Answer goes here</p>"
					}
				]
			}
		],
		"presets": [
			{
				"name": "Main Contact",
				"category": "Contact",
				"blocks": [
					{ "type": "faq" },
					{ "type": "faq" },
					{ "type": "faq" },
					{ "type": "faq" },
					{ "type": "faq" }
				]
			}
		]
	}
{% endschema %}
